{
  "name": "Retail Agentic AI (FastAPI + React)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/app.py",
        "frontend/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r backend/requirements.txt && npm install --prefix frontend && echo '✅ Backend + frontend dependencies installed'",
  "postAttachCommand": {
    "backend": "cd backend && python -m uvicorn app:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "cd frontend && npm run dev -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
